rules_version = '2';

// Afterglow shared videos and profile photos. Only you can add or remove your
// own files; anyone signed in can watch shared ones. Sizes are capped here.
// Deploy with: npx firebase-tools deploy --only storage  (see docs/firebase-setup.md)
service firebase.storage {
  match /b/{bucket}/o {
    match /memories/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9]+[.](mp4|mov|m4v|jpg)$')
        && (
          (file.matches('.*[.]jpg$') && request.resource.contentType == 'image/jpeg' && request.resource.size < 5 * 1024 * 1024)
          || (file.matches('.*[.](mp4|mov|m4v)$') && request.resource.contentType.matches('video/.*') && request.resource.size < 150 * 1024 * 1024)
        );
      // The support account can take down a video that breaks the guidelines.
      allow delete: if request.auth != null && (request.auth.uid == uid
        || (request.auth.token.email == 'afterglowmusic.support@gmail.com' && request.auth.token.email_verified == true));
    }
    // Videos sent to a crew only. Their links live only in the crew's updates, which only members can read
    // (firestore.rules); the file names are random. You add and remove only your own. Writing over your
    // own file is allowed, so a send that stopped after the upload can try again with the same name.
    match /crews/{crewId}/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9_-]+[.](mp4|mov|m4v|jpg)$')
        && (
          (file.matches('.*[.]jpg$') && request.resource.contentType == 'image/jpeg' && request.resource.size < 5 * 1024 * 1024)
          || (file.matches('.*[.](mp4|mov|m4v)$') && request.resource.contentType.matches('video/.*') && request.resource.size < 150 * 1024 * 1024)
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // An event organizer's logo, icon and event posters (features/organizers): anyone can see them (its page
    // is public). You upload only into your own folder; which picture an organizer or event shows is set on
    // its page in the database, where only its team or HQ may set it (firestore.rules). PNG, JPEG or WebP:
    // a logo or icon under 5 MB, a poster under 10 MB.
    match /orgs/{orgId}/{uid}/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && file.matches('^(logo|icon|poster)-[0-9]{1,15}[.](png|jpg|webp)$')
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && request.resource.size < (file.matches('^poster-.*') ? 10 : 5) * 1024 * 1024;
    }
    // A profile's cover photo: your own, a JPEG under 8 MB.
    match /covers/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && file == request.auth.uid + '.jpg'
        && (request.resource == null || (request.resource.contentType == 'image/jpeg' && request.resource.size < 8 * 1024 * 1024));
    }
    // HQ uploads: lineup and set-times pictures, PDFs and text, only for the support account (verified email).
    match /drops/{dropId}/{file} {
      allow read, write: if request.auth != null && request.auth.token.email == 'afterglowmusic.support@gmail.com'
        && request.auth.token.email_verified == true
        && (request.resource == null || (request.resource.size < 25 * 1024 * 1024
          && request.resource.contentType.matches('^(image/.*|application/pdf|text/.*|application/json)$')));
    }
    // Festival maps: a festival's map picture, uploaded by HQ (who has the rights to it); anyone can see it.
    match /venueMaps/{festivalId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'afterglowmusic.support@gmail.com'
        && request.auth.token.email_verified == true
        && file.matches('^map-[0-9]{1,15}[.](png|jpg|webp)$')
        && (request.resource == null || (request.resource.contentType.matches('image/(png|jpeg|webp)') && request.resource.size < 15 * 1024 * 1024));
    }
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && file == request.auth.uid + '.jpg'
        && (request.resource == null || (request.resource.contentType == 'image/jpeg' && request.resource.size < 5 * 1024 * 1024));
    }
  }
}
