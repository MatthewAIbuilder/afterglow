rules_version = '2';

// Afterglow social profiles. The app is never trusted: these rules decide who
// may read and write what, with the same limits as src/features/social/validate.ts.
// Deploy with: npx firebase-tools deploy --only firestore  (see docs/firebase-setup.md)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // The Afterglow support account (the dashboard): only with that email, and only once it's verified.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'afterglowmusic.support@gmail.com' && request.auth.token.email_verified == true;
    }
    function reserved(h) {
      return h in ['afterglow', 'admin', 'administrator', 'support', 'help', 'official', 'staff', 'moderator', 'mod', 'team', 'root', 'system', 'me', 'you', 'null', 'undefined']
        || h.matches('^afterglow.*');
    }
    // 3 to 20 characters: letters, numbers, dots and underscores; starts and ends with a letter or number; no two dots/underscores in a row.
    function validHandle(h) {
      return h is string && h.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$') && !h.matches('.*[._][._].*') && !reserved(h);
    }
    function path(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    // An optional short text field: absent, or a string of at most `max` characters.
    function shortOrAbsent(data, field, max) { return !(field in data) || (data[field] is string && data[field].size() <= max); }

    // Profiles: anyone signed in can read; only you can write yours, and only
    // with a handle you own (claimed in the same transaction).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['handle', 'displayName', 'nameLower', 'bio', 'avatarUrl', 'coverUrl', 'festivals', 'sounds', 'showFestivals', 'showSound', 'createdAt', 'updatedAt'])
        && validHandle(request.resource.data.handle)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40
        && request.resource.data.nameLower == request.resource.data.displayName.lower()
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.festivals is list && request.resource.data.festivals.size() <= 50
        && request.resource.data.createdAt.size() <= 40 && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.sounds is list && request.resource.data.sounds.size() <= 3
        && request.resource.data.showFestivals is bool && request.resource.data.showSound is bool
        && (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.matches('^https://.*')))
        && (!('coverUrl' in request.resource.data) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 2000 && request.resource.data.coverUrl.matches('^https://.*')))
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && getAfter(path('handles', request.resource.data.handle)).data.uid == uid;
      allow delete: if signedIn() && me() == uid;
    }

    // Handles: one owner each. Claimed only together with your profile; never reassigned.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me()
        && getAfter(path('profiles', me())).data.handle == handle;
      allow update: if false;
      // Only when you're moving to another handle or deleting your profile, so a profile never points at a handle it doesn't own.
      allow delete: if signedIn() && resource.data.uid == me()
        && (!existsAfter(path('profiles', me())) || getAfter(path('profiles', me())).data.handle != handle);
    }

    // Shared memories: readable by anyone signed in; created only by their owner,
    // pointing at the owner's own files; never edited; deleted only by the owner.
    match /memories/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'memoryId', 'videoPath', 'videoUrl', 'thumbPath', 'thumbUrl', 'festivalId', 'night', 'artistId', 'pastName', 'pastYear', 'pastCity', 'seriesId', 'capturedAt', 'durationSec', 'width', 'height', 'createdAt'])
        && request.resource.data.handle == get(path('profiles', me())).data.handle
        && request.resource.data.videoPath.matches('^memories/' + me() + '/' + id + '[.](mp4|mov|m4v)$')
        && request.resource.data.videoUrl is string && request.resource.data.videoUrl.matches('^https://.*')
        && (!('thumbPath' in request.resource.data) || request.resource.data.thumbPath == 'memories/' + me() + '/' + id + '.jpg')
        && (!('thumbUrl' in request.resource.data) || (request.resource.data.thumbUrl is string && request.resource.data.thumbUrl.matches('^https://.*')))
        && shortOrAbsent(request.resource.data, 'festivalId', 100) && shortOrAbsent(request.resource.data, 'artistId', 100)
        && shortOrAbsent(request.resource.data, 'night', 40) && shortOrAbsent(request.resource.data, 'memoryId', 60)
        // A throwback (a past festival, from the camera roll): a name and year, never with a festival on Afterglow.
        && (!('pastName' in request.resource.data) || (!('festivalId' in request.resource.data)
          && request.resource.data.pastName is string && request.resource.data.pastName.size() > 0 && request.resource.data.pastName.size() <= 60
          && request.resource.data.pastYear is int && request.resource.data.pastYear >= 1990 && request.resource.data.pastYear <= 2100))
        && (!('pastYear' in request.resource.data) || 'pastName' in request.resource.data)
        && shortOrAbsent(request.resource.data, 'pastCity', 60) && shortOrAbsent(request.resource.data, 'seriesId', 100)
        && (!('seriesId' in request.resource.data) || 'pastName' in request.resource.data)
        && (!('durationSec' in request.resource.data) || (request.resource.data.durationSec is number && request.resource.data.durationSec <= 600))
        && (!('width' in request.resource.data) || (request.resource.data.width is number && request.resource.data.width <= 20000))
        && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height <= 20000))
        && request.resource.data.capturedAt is string && request.resource.data.capturedAt.size() <= 40
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    // Blocks: private to you.
    match /blocks/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is list && request.resource.data.uids.size() <= 1000;
    }

    // Follows: `from` follows `to`. Anyone signed in can see who follows whom. You can only follow as
    // yourself, someone else with a profile, and not someone who blocked you; either of you can end it.
    // Scanning a friend's QR code makes it both ways: with proof you scanned their code (a friend link,
    // written in the same batch), you may also make them follow you (`via: 'code'`).
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
        && ((request.resource.data.from == me()
            && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
            && request.resource.data.to is string && request.resource.data.to != me()
            && id == me() + '_' + request.resource.data.to
            && exists(path('profiles', me())) && exists(path('profiles', request.resource.data.to))
            && !(exists(path('blocks', request.resource.data.to)) && me() in get(path('blocks', request.resource.data.to)).data.uids))
          || (request.resource.data.to == me()
            && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt', 'via']) && request.resource.data.via == 'code'
            && request.resource.data.from is string && request.resource.data.from != me()
            && id == request.resource.data.from + '_' + me()
            && exists(path('profiles', me())) && exists(path('profiles', request.resource.data.from))
            && !(exists(path('blocks', request.resource.data.from)) && me() in get(path('blocks', request.resource.data.from)).data.uids)
            && existsAfter(path('friendLinks', me() + '_' + request.resource.data.from))
            && getAfter(path('friendLinks', me() + '_' + request.resource.data.from)).data.code == get(path('friendCodes', request.resource.data.from)).data.code));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Friend codes: the private code in your QR code. Nobody reads it back, not even you; only these
    // rules compare a scanned code with it. A new code makes old ones stop working.
    // Founders: the first 100 people with a profile, numbered in the order they arrived. A shared counter
    // hands out the numbers: your number and the counter's next value are written together, so two people
    // never share one and nobody can pick theirs. Anyone can see them; nobody can change one. Leaving
    // removes yours, and the number is never given out again.
    function foundedAs(n) {
      return !exists(path('founders', me())) && existsAfter(path('founders', me()))
        && getAfter(path('founders', me())).data.number == n;
    }
    match /counters/founders {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1 && foundedAs(1);
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 100 && foundedAs(request.resource.data.count);
      allow delete: if false;
    }
    match /founders/{uid} {
      allow read: if true;
      allow create: if signedIn() && me() == uid && exists(path('profiles', uid))
        && request.resource.data.keys().hasOnly(['number', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.number is int
        && request.resource.data.number >= 1 && request.resource.data.number <= 100
        && getAfter(path('counters', 'founders')).data.count == request.resource.data.number
        && ((!exists(path('counters', 'founders')) && request.resource.data.number == 1)
          || (exists(path('counters', 'founders')) && get(path('counters', 'founders')).data.count + 1 == request.resource.data.number));
      allow update: if false;
      allow delete: if signedIn() && me() == uid;
    }
    // Flairs: a special border and caption (artists, the team, partners), given out by hand in the Firebase
    // console. Anyone can see them; nobody can write one from the app.
    // Afterglow Plus: given in the Firebase console for now (later by the App Store purchase, from a server).
    // Anyone can see it (it decides whether someone's videos show the edge glow); nobody writes it from the app.
    match /plus/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /flairs/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Glow levels from daily quests: your own, shown on your profile (switched off in Edit profile, which deletes it).
    // Anyone can see them; only you write yours, a whole number from 1 to 999, stamped with the server's time.
    match /levels/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['level', 'at'])
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 999
        && request.resource.data.at == request.time
        && exists(path('profiles', uid));
      allow delete: if signedIn() && me() == uid;
    }

    match /friendCodes/{uid} {
      allow read: if false;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[a-z0-9]{8,32}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // Friend links: proof you scanned someone's current code, made together with the follows.
    // Only the scanner can see or remove theirs.
    match /friendLinks/{id} {
      allow read, delete: if signedIn() && resource.data.from == me();
      allow create, update: if signedIn() && request.resource.data.from == me()
        && request.resource.data.keys().hasOnly(['from', 'to', 'code', 'createdAt'])
        && request.resource.data.to is string && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && exists(path('profiles', me())) && exists(path('profiles', request.resource.data.to))
        && exists(path('friendCodes', request.resource.data.to))
        && request.resource.data.code == get(path('friendCodes', request.resource.data.to)).data.code
        && !(exists(path('blocks', request.resource.data.to)) && me() in get(path('blocks', request.resource.data.to)).data.uids)
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
    }

    // Likes on shared videos: `uid` likes memory `memoryId`, shared by `owner`. Anyone signed in can see them.
    // Only as yourself, on a video that exists and isn't yours, not if its owner blocked you; either of you can remove it.
    match /likes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['memoryId', 'owner', 'uid', 'createdAt'])
        && request.resource.data.memoryId is string && id == request.resource.data.memoryId + '_' + me()
        && exists(path('memories', request.resource.data.memoryId))
        && get(path('memories', request.resource.data.memoryId)).data.uid == request.resource.data.owner
        && request.resource.data.owner != me()
        && !(exists(path('blocks', request.resource.data.owner)) && me() in get(path('blocks', request.resource.data.owner)).data.uids)
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == me() || resource.data.owner == me());
    }

    // Comments on shared videos: anyone signed in reads them; you write as yourself, with a profile, with your
    // own handle, on a video that exists (`owner` is its sharer), not if its owner blocked you; 1 to 300
    // characters. Never edited; removed by the writer or the video's owner.
    match /comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['memoryId', 'owner', 'uid', 'handle', 'text', 'createdAt'])
        && request.resource.data.memoryId is string
        && exists(path('memories', request.resource.data.memoryId))
        && get(path('memories', request.resource.data.memoryId)).data.uid == request.resource.data.owner
        && !(exists(path('blocks', request.resource.data.owner)) && me() in get(path('blocks', request.resource.data.owner)).data.uids)
        && exists(path('profiles', me()))
        && request.resource.data.handle == get(path('profiles', me())).data.handle
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
      allow delete: if (signedIn() && (resource.data.uid == me() || resource.data.owner == me())) || isAdmin();
    }

    // Festival crews: a few friends planning one festival. The id is the invite: anyone signed in who has it
    // can read the crew (its name and members) and join it, adding only themselves, up to 12, with a profile, not
    // if the owner blocked them. Members leave by removing only themselves (an owner who leaves hands it to a
    // member). The owner can rename it, remove people and delete it. Listing is only of crews you're in.
    function crewShape(d) {
      return d.keys().hasOnly(['festivalId', 'name', 'owner', 'members', 'createdAt'])
        && d.festivalId is string && d.festivalId.size() > 0 && d.festivalId.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.members is list && d.members.size() <= 12 && d.owner in d.members
        && d.createdAt is string && d.createdAt.size() <= 40;
    }
    function blockedBy(uid) { return exists(path('blocks', uid)) && me() in get(path('blocks', uid)).data.uids; }
    // Crew invites sent in the app: `crewId_to`. A member of the crew invites someone with a profile who
    // hasn't blocked them, as themselves, stamped with the server's time. Only the two of them can see it;
    // either can remove it (joining or saying no). Inviting again overwrites it.
    match /crewInvites/{id} {
      allow read: if signedIn() && (resource.data.to == me() || resource.data.from == me());
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['crewId', 'festivalId', 'crewName', 'from', 'to', 'createdAt'])
        && request.resource.data.from == me() && request.resource.data.to is string && request.resource.data.to != me()
        && request.resource.data.crewId is string
        && id == request.resource.data.crewId + '_' + request.resource.data.to
        && me() in get(path('crews', request.resource.data.crewId)).data.members
        && !(request.resource.data.to in get(path('crews', request.resource.data.crewId)).data.members)
        && request.resource.data.festivalId == get(path('crews', request.resource.data.crewId)).data.festivalId
        && request.resource.data.crewName is string && request.resource.data.crewName.size() <= 40
        && request.resource.data.createdAt == request.time
        && exists(path('profiles', request.resource.data.to))
        && !blockedBy(request.resource.data.to);
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from == me());
    }
    match /crews/{id} {
      allow get: if signedIn();
      allow list: if (signedIn() && me() in resource.data.members) || isAdmin();
      allow create: if signedIn() && crewShape(request.resource.data)
        && request.resource.data.owner == me() && request.resource.data.members == [me()]
        && exists(path('profiles', me()));
      allow update: if signedIn() && crewShape(request.resource.data)
        && request.resource.data.festivalId == resource.data.festivalId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Join: add only yourself, at the end.
          (!(me() in resource.data.members)
            && request.resource.data.members == resource.data.members.concat([me()])
            && request.resource.data.owner == resource.data.owner && request.resource.data.name == resource.data.name
            && exists(path('profiles', me())) && !blockedBy(resource.data.owner))
          // Leave: remove only yourself; an owner hands the crew to someone still in it.
          || (me() in resource.data.members
            && request.resource.data.members == resource.data.members.removeAll([me()])
            && request.resource.data.name == resource.data.name
            && (request.resource.data.owner == resource.data.owner || resource.data.owner == me()))
          // The owner: rename, or remove other people (never add anyone).
          || (resource.data.owner == me() && request.resource.data.owner == me()
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0)
        );
      allow delete: if signedIn() && resource.data.owner == me();

      // Each member's starred sets, shared with the crew: written by that member, read by members,
      // removed by that member or the owner.
      match /picks/{uid} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create, update: if signedIn() && me() == uid && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['artists', 'updatedAt'])
          && request.resource.data.artists is list && request.resource.data.artists.size() <= 100
          && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
        allow delete: if signedIn() && (me() == uid || get(path('crews', id)).data.owner == me());
      }

      // The crew's meeting spot ("by the big tree left of Main Stage"): read and set by any member, as
      // themselves, stamped with the server's time. One document, `meet`.
      match /meta/{doc} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create, update: if signedIn() && doc == 'meet' && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['text', 'by', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80
          && request.resource.data.by == me()
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && me() in get(path('crews', id)).data.members;
      }

      // Crew updates: where a member is and what they're seeing, from a video or a check-in. Members read
      // them; you post only as yourself while you're in the crew. `atMs` is when it happened on the phone
      // (no later than now, no older than a week); `sentAt` must be the server's own time, so "reached
      // the crew at" can't be faked. A reply answers another update in the crew. Never edited; removed by
      // the author or the owner.
      match /updates/{updateId} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create: if signedIn() && me() in get(path('crews', id)).data.members
          && updateId.matches('^[A-Za-z0-9_-]{6,64}$')
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'atMs', 'sentAt', 'festivalId', 'artistId', 'stage', 'note', 'videoUrl', 'thumbUrl', 'videoPath', 'thumbPath', 'sharedId', 'durationSec', 'width', 'height', 'replyTo', 'lost', 'care'])
          && request.resource.data.uid == me()
          && request.resource.data.kind in ['video', 'checkin', 'reply', 'photo']
          && request.resource.data.atMs is number
          && request.resource.data.atMs <= request.time.toMillis() + 300000
          && request.resource.data.atMs >= request.time.toMillis() - 7 * 24 * 3600 * 1000
          && request.resource.data.sentAt == request.time
          && request.resource.data.festivalId is string && request.resource.data.festivalId.size() <= 100
          && request.resource.data.festivalId == get(path('crews', id)).data.festivalId
          && shortOrAbsent(request.resource.data, 'artistId', 100)
          && shortOrAbsent(request.resource.data, 'stage', 60)
          && shortOrAbsent(request.resource.data, 'note', 80)
          && shortOrAbsent(request.resource.data, 'sharedId', 128)
          && shortOrAbsent(request.resource.data, 'videoPath', 300)
          && shortOrAbsent(request.resource.data, 'thumbPath', 300)
          && (!('videoUrl' in request.resource.data) || (request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() <= 2000 && request.resource.data.videoUrl.matches('^https://.*')))
          && (!('thumbUrl' in request.resource.data) || (request.resource.data.thumbUrl is string && request.resource.data.thumbUrl.size() <= 2000 && request.resource.data.thumbUrl.matches('^https://.*')))
          && (request.resource.data.kind != 'video' || 'videoUrl' in request.resource.data)
          // A photo (crews only): the picture, and no video.
          && (request.resource.data.kind != 'photo' || ('thumbUrl' in request.resource.data && !('videoUrl' in request.resource.data)))
          // A reply has words and answers an update that's in this crew.
          && (request.resource.data.kind != 'reply' || (request.resource.data.replyTo is string
            && request.resource.data.replyTo.matches('^[A-Za-z0-9_-]{6,64}$')
            && exists(/databases/$(database)/documents/crews/$(id)/updates/$(request.resource.data.replyTo))
            && request.resource.data.note is string && request.resource.data.note.size() > 0
            && !('videoUrl' in request.resource.data)))
          && (request.resource.data.kind == 'reply' || !('replyTo' in request.resource.data))
          // "Can't find you": only on a check-in.
          && (!('lost' in request.resource.data) || (request.resource.data.lost == true && request.resource.data.kind == 'checkin'))
          // "I'm OK" or "come find me": only on a check-in.
          && (!('care' in request.resource.data) || (request.resource.data.care in ['ok', 'help'] && request.resource.data.kind == 'checkin'))
          && (!('durationSec' in request.resource.data) || (request.resource.data.durationSec is number && request.resource.data.durationSec <= 600))
          && (!('width' in request.resource.data) || (request.resource.data.width is number && request.resource.data.width <= 20000))
          && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height <= 20000));
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == me() || get(path('crews', id)).data.owner == me());
      }
    }

    // Reports: anyone signed in can file one; only the project owner reads them (in the Firebase console).
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['by', 'kind', 'targetId', 'ownerUid', 'reason', 'note', 'createdAt'])
        && request.resource.data.kind in ['profile', 'memory', 'comment']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128
        && request.resource.data.ownerUid is string && request.resource.data.ownerUid.size() <= 128
        && request.resource.data.reason in ['offensive', 'harassment', 'spam', 'not-theirs', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
      // Read and dealt with on the support account's dashboard.
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['open', 'resolved'];
    }

    // Support messages: you write yours (as yourself, marked open, stamped with the server's time) and read
    // only your own; the support account reads them all, replies, and closes them.
    match /support/{id} {
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'name', 'email', 'topic', 'text', 'platform', 'version', 'status', 'createdAt'])
        && request.resource.data.topic in ['help', 'bug', 'idea', 'festival', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && shortOrAbsent(request.resource.data, 'handle', 30)
        && shortOrAbsent(request.resource.data, 'name', 60)
        && shortOrAbsent(request.resource.data, 'email', 200)
        && shortOrAbsent(request.resource.data, 'platform', 20)
        && shortOrAbsent(request.resource.data, 'version', 80);
      allow read: if signedIn() && (resource.data.uid == me() || isAdmin());
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt'])
        && request.resource.data.status in ['open', 'answered', 'closed']
        && shortOrAbsent(request.resource.data, 'reply', 2000);
      allow delete: if isAdmin();
    }
  }
}
