rules_version = '2';

// Afterglow social profiles. The app is never trusted: these rules decide who
// may read and write what, with the same limits as src/features/social/validate.ts.
// Deploy with: npx firebase-tools deploy --only firestore  (see docs/firebase-setup.md)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // The Afterglow support account (the dashboard): only with that email, and only once it's verified.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'afterglowmusic.support@gmail.com' && request.auth.token.email_verified == true;
    }
    function reserved(h) {
      return h in ['afterglow', 'admin', 'administrator', 'support', 'help', 'official', 'staff', 'moderator', 'mod', 'team', 'root', 'system', 'me', 'you', 'null', 'undefined']
        || h.matches('^afterglow.*');
    }
    // 3 to 20 characters: letters, numbers, dots and underscores; starts and ends with a letter or number; no two dots/underscores in a row.
    function validHandle(h) {
      return h is string && h.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$') && !h.matches('.*[._][._].*') && !reserved(h);
    }
    function path(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    // Afterglow Plus, given in the console: active (an end date isn't checked here).
    // Two people who follow each other (1-to-1 chats are only between friends both ways).
    function friendsBothWays(a, b) { return exists(path('follows', a + '_' + b)) && exists(path('follows', b + '_' + a)); }
    function hasBlocked(who, uid) { return exists(path('blocks', who)) && uid in get(path('blocks', who)).data.uids; }
    // Gift themes (features/themes/gifts.ts): only these can be given, only by these handles.
    function giftThemes() { return ['daisy']; }
    function giftGivers() { return ['matt.raves']; }
    function hasPlus(uid) { return exists(path('plus', uid)) && get(path('plus', uid)).data.active == true; }
    // Event organizers (features/organizers): an email HQ lets run an organizer's page, once that email is confirmed.
    function orgEmail() { return request.auth.token.email.lower(); }
    // Or an account HQ linked to it (in the organizer's `uids`).
    function isOrgMember(orgId) {
      return signedIn() && orgId is string && orgId.size() > 0 && (
        (request.auth.token.email_verified == true
          && exists(path('orgMembers', orgEmail()))
          && get(path('orgMembers', orgEmail())).data.orgId == orgId)
        || me() in get(path('orgs', orgId)).data.get('uids', []));
    }
    // A 1-to-1 chat with an event organizer's account (`org` names the organizer, and one of the two runs it):
    // anyone may message an organizer, no following needed.
    function orgChat(d) {
      return d.get('org', '') is string && d.get('org', '') != '' && exists(path('orgs', d.org))
        && (d.members[0] in get(path('orgs', d.org)).data.get('uids', []) || d.members[1] in get(path('orgs', d.org)).data.get('uids', []));
    }
    // An optional short text field: absent, or a string of at most `max` characters.
    // A push address record (features/notifications/push.ts): up to five Expo push tokens (one per phone),
    // the language the phone speaks, at the server's time.
    function pushShape(d) {
      return d.keys().hasOnly(['tokens', 'lang', 'at'])
        && d.tokens is list && d.tokens.size() > 0 && d.tokens.size() <= 5
        && d.tokens[0] is string && d.tokens[0].size() <= 200
        && d.lang in ['en', 'es']
        && d.at == request.time;
    }
    function shortOrAbsent(data, field, max) { return !(field in data) || (data[field] is string && data[field].size() <= max); }

    // Profiles: anyone signed in can read; only you can write yours, and only
    // with a handle you own (claimed in the same transaction).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['handle', 'displayName', 'nameLower', 'bio', 'avatarUrl', 'coverUrl', 'festivals', 'shows', 'sounds', 'showFestivals', 'showSound', 'artists', 'showArtists', 'backdrop', 'createdAt', 'updatedAt', 'instagram', 'snapchat', 'tiktok'])
        // Usernames only (the app makes the links), in each service's own shape.
        && (!('instagram' in request.resource.data) || (request.resource.data.instagram is string && request.resource.data.instagram.matches('^[a-z0-9._]{1,30}$')))
        && (!('snapchat' in request.resource.data) || (request.resource.data.snapchat is string && request.resource.data.snapchat.matches('^[a-z][a-z0-9._-]{2,14}$')))
        && (!('tiktok' in request.resource.data) || (request.resource.data.tiktok is string && request.resource.data.tiktok.matches('^[a-z0-9._]{2,24}$')))
        && validHandle(request.resource.data.handle)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40
        && request.resource.data.nameLower == request.resource.data.displayName.lower()
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.festivals is list && request.resource.data.festivals.size() <= 50
        // One-night shows they're going to (ids), alongside the festivals.
        && (!('shows' in request.resource.data) || (request.resource.data.shows is list && request.resource.data.shows.size() <= 30))
        && request.resource.data.createdAt.size() <= 40 && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.sounds is list && request.resource.data.sounds.size() <= 3
        && request.resource.data.showFestivals is bool && request.resource.data.showSound is bool
        && (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.matches('^https://.*')))
        && (!('coverUrl' in request.resource.data) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 2000 && request.resource.data.coverUrl.matches('^https://.*')))
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        // Favourite artists round your photo (up to 6 ids), and an animated background: a style name, the
        // panda garden, the frog pond, the toe beach and the gnome garden only on the profiles they were made for.
        && (!('artists' in request.resource.data) || (request.resource.data.artists is list && request.resource.data.artists.size() <= 6))
        && (!('showArtists' in request.resource.data) || request.resource.data.showArtists is bool)
        && (!('backdrop' in request.resource.data) || (request.resource.data.backdrop is string && request.resource.data.backdrop.matches('^[a-z-]{1,20}$')
          && (request.resource.data.backdrop != 'panda' || uid == '8EEXIUNCQghOnejeAOygGMSl6Bp1')
          && (request.resource.data.backdrop != 'frog' || uid == '6i9w14pQcdR05jYEUvPmadkQ6NZ2')
          && (request.resource.data.backdrop != 'toes' || uid == 'QdMqoH4PeEfvkBmiKAzdnWyBUlL2')
          && (request.resource.data.backdrop != 'gnome' || uid == '8EEXIUNCQghOnejeAOygGMSl6Bp1')
          // A gift background: only with its grant (a sprout that came with it), or for whoever gives them.
          && (!(request.resource.data.backdrop in giftThemes()) || request.resource.data.handle in giftGivers() || exists(path('themeGrants', uid + '_' + request.resource.data.backdrop)))))
        && getAfter(path('handles', request.resource.data.handle)).data.uid == uid;
      allow delete: if signedIn() && me() == uid;
    }

    // Handles: one owner each. Claimed only together with your profile; never reassigned.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me()
        && getAfter(path('profiles', me())).data.handle == handle;
      allow update: if false;
      // Only when you're moving to another handle or deleting your profile, so a profile never points at a handle it doesn't own.
      allow delete: if signedIn() && resource.data.uid == me()
        && (!existsAfter(path('profiles', me())) || getAfter(path('profiles', me())).data.handle != handle);
    }

    // Shared memories: readable by anyone signed in; created only by their owner,
    // pointing at the owner's own files; never edited; deleted only by the owner.
    match /memories/{id} {
      // Where a shared video is from and who was playing: checked when it's shared and when its tags change.
      function memoryTagsOk(d) {
        return shortOrAbsent(d, 'festivalId', 100) && shortOrAbsent(d, 'artistId', 100)
        && shortOrAbsent(d, 'night', 40) && shortOrAbsent(d, 'memoryId', 60)
        // A throwback (a past festival, from the camera roll): a name and year, never with a festival on Afterglow.
        && (!('pastName' in d) || (!('festivalId' in d)
          && d.pastName is string && d.pastName.size() > 0 && d.pastName.size() <= 60
          && d.pastYear is int && d.pastYear >= 1990 && d.pastYear <= 2100))
        && (!('pastYear' in d) || 'pastName' in d)
        && shortOrAbsent(d, 'pastCity', 60) && shortOrAbsent(d, 'seriesId', 100)
        && (!('seriesId' in d) || 'pastName' in d)
        // A one-night show (a club night or concert): a name and a day, never with a festival or a throwback.
        && (!('showName' in d) || (!('festivalId' in d) && !('pastName' in d)
          && d.showName is string && d.showName.size() > 0 && d.showName.size() <= 60
          && d.showDate is string && d.showDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('showDate' in d) || 'showName' in d)
        && shortOrAbsent(d, 'showCity', 60) && shortOrAbsent(d, 'showId', 100)
        && (!('showCity' in d) || 'showName' in d)
        && (!('showId' in d) || 'showName' in d)
        // Back to back: up to three more artists, only with a main one.
        && (!('withArtistIds' in d) || ('artistId' in d && d.withArtistIds is list && d.withArtistIds.size() <= 3))
        // An artist not on Afterglow yet: their name as typed, only with their id.
        && (!('artistName' in d) || ('artistId' in d && d.artistName is string && d.artistName.size() > 0 && d.artistName.size() <= 60))
        // The song playing (found by Shazam, kept by the person who filmed it): a title and an artist, and maybe its Apple Music link.
        && (!('trackTitle' in d) || ('trackArtist' in d && d.trackTitle is string && d.trackTitle.size() > 0 && d.trackTitle.size() <= 120))
        && (!('trackArtist' in d) || ('trackTitle' in d && d.trackArtist is string && d.trackArtist.size() > 0 && d.trackArtist.size() <= 120))
        && (!('trackUrl' in d) || ('trackTitle' in d && d.trackUrl is string && d.trackUrl.size() <= 300 && d.trackUrl.matches('^https://music[.]apple[.]com/.*')));
      }
      // Throwbacks are counted: the count moves on by one in the same write, and stops at 3 without Afterglow Plus.
      function throwbackCounted(id) {
        return getAfter(path('usage', me())).data.memory == id
          && getAfter(path('usage', me())).data.throwbacks == (exists(path('usage', me())) ? get(path('usage', me())).data.throwbacks : 0) + 1
          && (getAfter(path('usage', me())).data.throwbacks <= 3 || hasPlus(me()));
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'memoryId', 'videoPath', 'videoUrl', 'thumbPath', 'thumbUrl', 'festivalId', 'night', 'artistId', 'withArtistIds', 'artistName', 'pastName', 'pastYear', 'pastCity', 'seriesId', 'showName', 'showDate', 'showCity', 'showId', 'clipStart', 'clipEnd', 'trackTitle', 'trackArtist', 'trackUrl', 'capturedAt', 'durationSec', 'width', 'height', 'createdAt'])
        && request.resource.data.handle == get(path('profiles', me())).data.handle
        && request.resource.data.videoPath.matches('^memories/' + me() + '/' + id + '[.](mp4|mov|m4v)$')
        // The links are this owner's own uploads for this memory: Firebase Storage download links to memories/<uid>/<id>.
        && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() <= 2000
        && request.resource.data.videoUrl.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/[a-z0-9._-]+/o/memories%2F' + me() + '%2F' + id + '[.](mp4|mov|m4v)[?]alt=media&token=[A-Za-z0-9-]+$')
        && (!('thumbPath' in request.resource.data) || request.resource.data.thumbPath == 'memories/' + me() + '/' + id + '.jpg')
        && (!('thumbUrl' in request.resource.data) || (request.resource.data.thumbUrl is string && request.resource.data.thumbUrl.size() <= 2000
          && request.resource.data.thumbUrl.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/[a-z0-9._-]+/o/memories%2F' + me() + '%2F' + id + '[.]jpg[?]alt=media&token=[A-Za-z0-9-]+$')))
        && memoryTagsOk(request.resource.data)
        // A trimmed video: the part that plays, at most a minute (and a second's grace) of it.
        && (!('clipStart' in request.resource.data) || ('clipEnd' in request.resource.data
          && request.resource.data.clipStart is number && request.resource.data.clipEnd is number
          && request.resource.data.clipStart >= 0 && request.resource.data.clipEnd <= 3600
          && request.resource.data.clipEnd - request.resource.data.clipStart >= 1 && request.resource.data.clipEnd - request.resource.data.clipStart <= 61))
        && (!('clipEnd' in request.resource.data) || 'clipStart' in request.resource.data)
        && (!('pastName' in request.resource.data) || throwbackCounted(id))
        && (!('durationSec' in request.resource.data) || (request.resource.data.durationSec is number && request.resource.data.durationSec <= 600))
        && (!('width' in request.resource.data) || (request.resource.data.width is number && request.resource.data.width <= 20000))
        && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height <= 20000))
        && request.resource.data.capturedAt is string && request.resource.data.capturedAt.size() <= 40
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      // Only you change your own video's tags (where it's from, who was playing); nothing else about it.
      // A throwback stays a throwback (its year and name can change), and nothing else becomes one, so the count holds.
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['festivalId', 'night', 'artistId', 'withArtistIds', 'artistName', 'pastName', 'pastYear', 'pastCity', 'seriesId', 'showName', 'showDate', 'showCity', 'showId', 'trackTitle', 'trackArtist', 'trackUrl'])
        && memoryTagsOk(request.resource.data)
        && (('pastName' in request.resource.data) == ('pastName' in resource.data));
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    // Blocks: private to you.
    // People tagged in a shared video (`<memoryId>_<uid>`): the video's owner tags someone (never themselves, never
    // someone who blocked them); it waits until that person says yes, and only then shows on their profile. Either of
    // them can take it off. Anyone signed in sees the ones said yes to; a waiting one, only those two.
    match /videoTags/{id} {
      allow read: if signedIn() && (resource.data.status == 'approved' || resource.data.uid == me() || resource.data.owner == me());
      allow create: if signedIn() && request.resource.data.owner == me()
        && request.resource.data.keys().hasOnly(['memoryId', 'owner', 'uid', 'status', 'createdAt'])
        // Shows on their profile straight away ('pending' from older apps); they can hide it (delete) any time.
        && request.resource.data.status in ['approved', 'pending']
        && request.resource.data.uid is string && request.resource.data.uid != me() && request.resource.data.uid.size() <= 128
        && request.resource.data.memoryId is string && request.resource.data.memoryId.size() <= 100
        && id == request.resource.data.memoryId + '_' + request.resource.data.uid
        && get(path('memories', request.resource.data.memoryId)).data.uid == me()
        && exists(path('profiles', request.resource.data.uid))
        && !hasBlocked(request.resource.data.uid, me())
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'approved';
      allow delete: if (signedIn() && (resource.data.uid == me() || resource.data.owner == me())) || isAdmin();
    }
    match /blocks/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is list && request.resource.data.uids.size() <= 1000;
    }

    // Follows: `from` follows `to`. Anyone signed in can see who follows whom. You can only follow as
    // yourself, someone else with a profile, and not someone who blocked you; either of you can end it.
    // Scanning a friend's QR code makes it both ways: with proof you scanned their code (a friend link,
    // written in the same batch), you may also make them follow you (`via: 'code'`).
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
        && ((request.resource.data.from == me()
            && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
            && request.resource.data.to is string && request.resource.data.to != me()
            && id == me() + '_' + request.resource.data.to
            && exists(path('profiles', me())) && exists(path('profiles', request.resource.data.to))
            && !(exists(path('blocks', request.resource.data.to)) && me() in get(path('blocks', request.resource.data.to)).data.uids))
          || (request.resource.data.to == me()
            && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt', 'via']) && request.resource.data.via == 'code'
            && request.resource.data.from is string && request.resource.data.from != me()
            && id == request.resource.data.from + '_' + me()
            && exists(path('profiles', me())) && exists(path('profiles', request.resource.data.from))
            && !(exists(path('blocks', request.resource.data.from)) && me() in get(path('blocks', request.resource.data.from)).data.uids)
            && existsAfter(path('friendLinks', me() + '_' + request.resource.data.from))
            && getAfter(path('friendLinks', me() + '_' + request.resource.data.from)).data.code == get(path('friendCodes', request.resource.data.from)).data.code));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Friend codes: the private code in your QR code. Nobody reads it back, not even you; only these
    // rules compare a scanned code with it. A new code makes old ones stop working.
    // Founders: the first 100 people with a profile, numbered in the order they arrived. A shared counter
    // hands out the numbers: your number and the counter's next value are written together, so two people
    // never share one and nobody can pick theirs. Anyone can see them; nobody can change one. Leaving
    // removes yours, and the number is never given out again.
    function foundedAs(n) {
      return !exists(path('founders', me())) && existsAfter(path('founders', me()))
        && getAfter(path('founders', me())).data.number == n;
    }
    match /counters/founders {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1 && foundedAs(1);
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 100 && foundedAs(request.resource.data.count);
      allow delete: if false;
    }
    match /founders/{uid} {
      allow read: if true;
      allow create: if signedIn() && me() == uid && exists(path('profiles', uid))
        && request.resource.data.keys().hasOnly(['number', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.number is int
        && request.resource.data.number >= 1 && request.resource.data.number <= 100
        && getAfter(path('counters', 'founders')).data.count == request.resource.data.number
        && ((!exists(path('counters', 'founders')) && request.resource.data.number == 1)
          || (exists(path('counters', 'founders')) && get(path('counters', 'founders')).data.count + 1 == request.resource.data.number));
      allow update: if false;
      allow delete: if signedIn() && me() == uid;
    }
    // Flairs: a special border and caption (artists, the team, partners), given out by hand in the Firebase
    // console. Anyone can see them; nobody can write one from the app.
    // Afterglow Plus: given from HQ (the support account) or the Firebase console (later by the App Store
    // purchase, from a server). Anyone can see it (it decides whether someone's videos show the edge glow).
    match /plus/{uid} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['active', 'until'])
        && request.resource.data.active == true && shortOrAbsent(request.resource.data, 'until', 40);
    }
    match /flairs/{uid} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['kind', 'caption'])
        && request.resource.data.kind in ['artist', 'team', 'partner']
        && request.resource.data.caption is string && request.resource.data.caption.size() > 0 && request.resource.data.caption.size() <= 40;
    }

    // HQ uploads (lineup and set-times pictures, PDFs and text for Afterglow to add): only the support account.
    match /drops/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['by', 'festivalId', 'festivalName', 'note', 'text', 'files', 'status', 'createdAt'])
        && request.resource.data.status == 'waiting' && request.resource.data.createdAt == request.time
        && request.resource.data.files is list && request.resource.data.files.size() <= 10
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && shortOrAbsent(request.resource.data, 'festivalId', 100) && shortOrAbsent(request.resource.data, 'festivalName', 120)
        && shortOrAbsent(request.resource.data, 'text', 50000);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['waiting', 'sent', 'done'];
    }

    // Set times a fan sent for a festival (text and/or a shrunk photo), for HQ to check before anything
    // is published. One waiting per festival per person; the sender reads their own (to be thanked once
    // live) and can take it back; only HQ marks it live (dropping the photo) or declines it.
    match /setTimes/{id} {
      allow get, list: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'festivalId', 'text', 'photo', 'status', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.festivalId is string && request.resource.data.festivalId.matches('^[A-Za-z0-9_.-]{1,64}$')
        && id == me() + '_' + request.resource.data.festivalId
        && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time
        && ('text' in request.resource.data || 'photo' in request.resource.data)
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 20000))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 900000
          && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'photo'])
        && request.resource.data.status == 'live' && !('photo' in request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == me());
    }

    // Catalogue updates published from HQ: every app reads them on top of its catalogue (they're public
    // lineup facts); only the support account publishes or takes them down. Never edited.
    match /published/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['title', 'festivalId', 'file', 'by', 'publishedAt', 'dropId'])
        && request.resource.data.publishedAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.festivalId is string && request.resource.data.festivalId.size() <= 100
        && request.resource.data.file is string && request.resource.data.file.size() <= 800000
        && shortOrAbsent(request.resource.data, 'dropId', 100);
      allow update: if false;
    }
    // App-wide switches set from HQ (the care timing guide): every app reads them, signed in or not; only the
    // support account changes them. One document, `app`.
    match /appSettings/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id == 'app'
        && request.resource.data.keys().hasOnly(['careGuide', 'by', 'at'])
        && request.resource.data.careGuide is bool
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // What your free plan has used: throwbacks shared (videos from past festivals). Read only by you; it moves only with
    // a throwback shared (one more) or removed (one fewer) in the same write.
    match /usage/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['throwbacks', 'memory'])
        && request.resource.data.throwbacks is int && request.resource.data.memory is string
        && (
          (request.resource.data.throwbacks == (resource == null ? 0 : resource.data.throwbacks) + 1
            && !exists(path('memories', request.resource.data.memory))
            && getAfter(path('memories', request.resource.data.memory)).data.uid == me()
            && 'pastName' in getAfter(path('memories', request.resource.data.memory)).data)
          || (resource != null && request.resource.data.throwbacks == resource.data.throwbacks - 1
            && exists(path('memories', request.resource.data.memory))
            && get(path('memories', request.resource.data.memory)).data.uid == me()
            && 'pastName' in get(path('memories', request.resource.data.memory)).data
            && !existsAfter(path('memories', request.resource.data.memory)))
        );
      // Only once your profile is gone (deleting your account), so the count can't be reset.
      allow delete: if signedIn() && me() == uid && !exists(path('profiles', uid));
    }

    // Glow levels from daily quests: your own, shown on your profile (switched off in Edit profile, which deletes it).
    // Anyone can see them; only you write yours, a whole number from 1 to 999, stamped with the server's time.
    match /levels/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['level', 'at'])
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 999
        && request.resource.data.at == request.time
        && exists(path('profiles', uid));
      allow delete: if signedIn() && me() == uid;
    }

    match /friendCodes/{uid} {
      allow read: if false;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[a-z0-9]{8,32}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // Friend links: proof you scanned someone's current code, made together with the follows.
    // Only the scanner can see or remove theirs.
    // Invites (features/invites): you joined from someone's invite link. Written once by you, with your
    // profile, naming someone else who has one; never changed (so an account counts once, for one inviter).
    // Read by you, by whoever invited you (to count their invites), and by the support account (HQ's rewards).
    match /invites/{uid} {
      allow read: if signedIn() && (me() == uid || resource.data.by == me() || isAdmin());
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by is string && request.resource.data.by != uid
        && request.resource.data.at == request.time
        && exists(path('profiles', uid)) && exists(path('profiles', request.resource.data.by));
      allow update: if false;
      allow delete: if signedIn() && me() == uid;
    }
    match /friendLinks/{id} {
      allow read, delete: if signedIn() && resource.data.from == me();
      allow create, update: if signedIn() && request.resource.data.from == me()
        && request.resource.data.keys().hasOnly(['from', 'to', 'code', 'createdAt'])
        && request.resource.data.to is string && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && exists(path('profiles', me())) && exists(path('profiles', request.resource.data.to))
        && exists(path('friendCodes', request.resource.data.to))
        && request.resource.data.code == get(path('friendCodes', request.resource.data.to)).data.code
        && !(exists(path('blocks', request.resource.data.to)) && me() in get(path('blocks', request.resource.data.to)).data.uids)
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
    }

    // Likes on shared videos: `uid` likes memory `memoryId`, shared by `owner`. Anyone signed in can see them.
    // Only as yourself, on a video that exists and isn't yours, not if its owner blocked you; either of you can remove it.
    match /likes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['memoryId', 'owner', 'uid', 'createdAt'])
        && request.resource.data.memoryId is string && id == request.resource.data.memoryId + '_' + me()
        && exists(path('memories', request.resource.data.memoryId))
        && get(path('memories', request.resource.data.memoryId)).data.uid == request.resource.data.owner
        && request.resource.data.owner != me()
        && !(exists(path('blocks', request.resource.data.owner)) && me() in get(path('blocks', request.resource.data.owner)).data.uids)
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == me() || resource.data.owner == me());
    }

    // Comments on shared videos: anyone signed in reads them; you write as yourself, with a profile, with your
    // own handle, on a video that exists (`owner` is its sharer), not if its owner blocked you; 1 to 300
    // characters. Never edited; removed by the writer or the video's owner.
    match /comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['memoryId', 'owner', 'uid', 'handle', 'text', 'createdAt'])
        && request.resource.data.memoryId is string
        && exists(path('memories', request.resource.data.memoryId))
        && get(path('memories', request.resource.data.memoryId)).data.uid == request.resource.data.owner
        && !(exists(path('blocks', request.resource.data.owner)) && me() in get(path('blocks', request.resource.data.owner)).data.uids)
        && exists(path('profiles', me()))
        && request.resource.data.handle == get(path('profiles', me())).data.handle
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
      allow delete: if (signedIn() && (resource.data.uid == me() || resource.data.owner == me())) || isAdmin();
    }

    // Comments on clips in Discover (YouTube videos, SoundCloud cards, drawn stages): no one owns the clip, so
    // anyone signed in reads them; you write as yourself, with a profile, with your own handle, on a clip id of
    // letters, numbers and `_ . : -` (at most 128), 1 to 300 characters, at the server's time. Never edited;
    // removed by the writer or the support account.
    match /clipComments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['clipId', 'uid', 'handle', 'text', 'createdAt'])
        && request.resource.data.clipId is string && request.resource.data.clipId.matches('^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$')
        && exists(path('profiles', me()))
        && request.resource.data.handle == get(path('profiles', me())).data.handle
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    // Festival crews: a few friends planning one festival. The id is the invite: anyone signed in who has it
    // can read the crew (its name and members) and join it, adding only themselves, up to 12, with a profile, not
    // if the owner blocked them. Members leave by removing only themselves (an owner who leaves hands it to a
    // member). The owner can rename it, remove people and delete it. Listing is only of crews you're in.
    function crewShape(d) {
      return d.keys().hasOnly(['festivalId', 'name', 'owner', 'members', 'createdAt'])
        && d.festivalId is string && d.festivalId.size() > 0 && d.festivalId.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.members is list && d.members.size() <= 12 && d.owner in d.members
        && d.createdAt is string && d.createdAt.size() <= 40;
    }
    function blockedBy(uid) { return exists(path('blocks', uid)) && me() in get(path('blocks', uid)).data.uids; }
    // Crews are invite only. Joining writes `crews/{id}/joins/{you}` in the same transaction, saying you
    // agreed to the crew chat rules, and you need either an invite sent to you in the app or the code
    // from the crew's current invite link (which only members can read).
    function joinedFairly(id) {
      let joinPath = /databases/$(database)/documents/crews/$(id)/joins/$(me());
      let invitePath = /databases/$(database)/documents/crews/$(id)/meta/invite;
      return existsAfter(joinPath) && getAfter(joinPath).data.agreed == true
        && (exists(path('crewInvites', id + '_' + me()))
          || ('code' in getAfter(joinPath).data && exists(invitePath) && getAfter(joinPath).data.code == get(invitePath).data.code));
    }
    // Crew invites sent in the app: `crewId_to`. A member of the crew invites someone with a profile who
    // hasn't blocked them, as themselves, stamped with the server's time. Only the two of them can see it;
    // either can remove it (joining or saying no). Inviting again overwrites it.
    match /crewInvites/{id} {
      allow read: if (signedIn() && (resource.data.to == me() || resource.data.from == me())) || isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['crewId', 'festivalId', 'crewName', 'from', 'to', 'createdAt'])
        && request.resource.data.from == me() && request.resource.data.to is string && request.resource.data.to != me()
        && request.resource.data.crewId is string
        && id == request.resource.data.crewId + '_' + request.resource.data.to
        && me() in get(path('crews', request.resource.data.crewId)).data.members
        && !(request.resource.data.to in get(path('crews', request.resource.data.crewId)).data.members)
        && request.resource.data.festivalId == get(path('crews', request.resource.data.crewId)).data.festivalId
        && request.resource.data.crewName is string && request.resource.data.crewName.size() <= 40
        && request.resource.data.createdAt == request.time
        && exists(path('profiles', request.resource.data.to))
        && !blockedBy(request.resource.data.to);
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from == me());
    }
    // Sprouts: little gifts. The id is made on the giver's phone and shown as a code. The giver creates it
    // as themselves (with a profile), stamped with the server's time; anyone signed in with the code can
    // read it and pick it up once (not the giver, not someone the giver blocked) within 30 days. Never
    // otherwise changed. The giver takes back one nobody picked up; once someone's profile is gone,
    // their sprouts (given or picked up) can be removed with the account.
    match /sprouts/{id} {
      allow get: if signedIn() || isAdmin();
      allow list: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && id.matches('^[a-z0-9]{12,40}$')
        && request.resource.data.keys().hasOnly(['from', 'kind', 'note', 'festivalId', 'artistId', 'artistName', 'theme', 'via', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.kind in ['seedling', 'plur', 'wanderer', 'bass', 'melody', 'groove', 'spotlight', 'sunrise', 'moonlight', 'seeker', 'gnome', 'caterpillar', 'raccoon']
        // Given on from your garden (`via`): a sprout given to you, of this kind (or a plain one that grew into
        // it) and the same artist, not given on already, and marked given on as this one in the same write.
        && (!('via' in request.resource.data) || (request.resource.data.via is string
          && get(path('sprouts', request.resource.data.via)).data.get('to', '') == me()
          && get(path('sprouts', request.resource.data.via)).data.kind in [request.resource.data.kind, 'seedling']
          && get(path('sprouts', request.resource.data.via)).data.get('artistId', '') == request.resource.data.get('artistId', '')
          && !('passedOn' in get(path('sprouts', request.resource.data.via)).data)
          && getAfter(path('sprouts', request.resource.data.via)).data.get('passedOn', '') == id))
        // Gnome hats, caterpillars and raccoons come from their keepers (features/sprouts/sprouts.ts: GNOME_FRIENDS,
        // CATERPILLAR_FRIENDS, RACCOON_FRIENDS, KEEPS_EVERY_KIND), as many as they like, or are given on that way.
        && (request.resource.data.kind != 'gnome' || me() in ['8EEXIUNCQghOnejeAOygGMSl6Bp1', 'aC7a313susZsMUGWAM7GmRDyuRS2'] || 'via' in request.resource.data)
        && (request.resource.data.kind != 'caterpillar' || me() in ['xKdfDSjxYLSuIl37UpXGMFYGpWU2', 'aC7a313susZsMUGWAM7GmRDyuRS2'] || 'via' in request.resource.data)
        // Raccoons come from @nyxara (looked up by handle: RACCOON_FRIENDS) or the user's account, or are given on.
        && (request.resource.data.kind != 'raccoon' || me() == 'aC7a313susZsMUGWAM7GmRDyuRS2' || 'via' in request.resource.data
          || (exists(path('handles', 'nyxara')) && get(path('handles', 'nyxara')).data.uid == me()))
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 60))
        && (!('festivalId' in request.resource.data) || (request.resource.data.festivalId is string && request.resource.data.festivalId.size() <= 120))
        // An artist's sprout names the artist (id and name, together).
        && (('artistId' in request.resource.data) == ('artistName' in request.resource.data))
        && (!('artistId' in request.resource.data) || (request.resource.data.artistId is string && request.resource.data.artistId.matches('^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$')))
        && (!('artistName' in request.resource.data) || (request.resource.data.artistName is string && request.resource.data.artistName.size() >= 1 && request.resource.data.artistName.size() <= 60))
        // A gift theme comes only from the handles that give them.
        && (!('theme' in request.resource.data) || (request.resource.data.theme in giftThemes() && get(path('profiles', me())).data.handle in giftGivers()))
        && request.resource.data.createdAt == request.time
        && exists(path('profiles', me()));
      allow update: if signedIn() && ((
        !('to' in resource.data)
        && resource.data.from != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to', 'claimedAt'])
        && request.resource.data.to == me()
        && request.resource.data.claimedAt == request.time
        && request.time < resource.data.createdAt + duration.value(30, 'd')
        && !blockedBy(resource.data.from)
      ) || (
        // One you have, given on once: marked with the new one, made in the same write from it.
        resource.data.get('to', '') == me()
        && !('passedOn' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passedOn'])
        && request.resource.data.passedOn is string
        && getAfter(path('sprouts', request.resource.data.passedOn)).data.get('via', '') == id
      ) || (
        // Taken back: yours again once the one on its way is gone (nobody picked it up).
        resource.data.get('to', '') == me()
        && 'passedOn' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passedOn'])
        && !('passedOn' in request.resource.data)
        && !existsAfter(path('sprouts', resource.data.passedOn))
      ));
      allow delete: if signedIn() && (
        (resource.data.from == me() && !('to' in resource.data))
        || ((resource.data.from == me() || resource.data.get('to', '') == me()) && !exists(path('profiles', me())))
      );
    }
    // Your garden's private copy (features/sprouts/backup.ts): only you read or write it.
    match /gardenBackups/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }
    // Gardens as shown on profiles: who lives there (kinds, stages, artists and levels; nothing private),
    // written by their owner, visited by anyone signed in.
    match /gardens/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['residents', 'kandi', 'decor', 'updatedAt'])
        && request.resource.data.residents is list && request.resource.data.residents.size() <= 120
        && (!('kandi' in request.resource.data) || (request.resource.data.kandi is list && request.resource.data.kandi.size() <= 40))
        && (!('decor' in request.resource.data) || (request.resource.data.decor is list && request.resource.data.decor.size() <= 12))
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
      // Glows: a visitor's little light on someone's shown garden, one each (keyed by the visitor), the
      // time from the server. The garden's owner reads them all; a visitor reads only their own. Either
      // can take one away; nobody edits one.
      match /glows/{visitor} {
        allow get: if signedIn() && (me() == uid || me() == visitor);
        allow list: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == visitor && visitor != uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && exists(path('profiles', me()))
          && exists(path('gardens', uid))
          && !hasBlocked(uid, me());
        allow delete: if signedIn() && (me() == visitor || me() == uid);
      }
    }
    // Kandi: a friendship bracelet left in someone's garden. Made as yourself (with a profile) for someone
    // else with one, who hasn't blocked you: a word in letter beads, a bead pattern, a short note. Only the
    // two of you read it (the word and beads show in their garden through their own published garden);
    // either of you can remove it. Never edited.
    match /kandi/{id} {
      // Kandi left for someone: only the two of them read it. Kandi given by code (no `to` yet): anyone signed
      // in who has the code reads it (its id is long and random), until someone picks it up.
      allow get: if signedIn() && (resource.data.from == me() || resource.data.get('to', '') == me() || !('to' in resource.data));
      allow list: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'word', 'beads', 'note', 'charm', 'createdAt'])
        && request.resource.data.from == me()
        && (!('to' in request.resource.data)
          || (request.resource.data.to is string && request.resource.data.to != me()
            && exists(path('profiles', request.resource.data.to))
            && !hasBlocked(request.resource.data.to, me())))
        && request.resource.data.word is string && request.resource.data.word.matches('^[A-Z0-9 ♥★✿☺!?&+.]{1,12}$')
        && request.resource.data.beads in ['rainbow', 'pastel', 'neon', 'uv', 'sunset', 'ocean', 'mono', 'candy', 'glow', 'galaxy', 'pride', 'gold', 'fire', 'holo', 'toxic', 'berry']
        && (!('charm' in request.resource.data) || request.resource.data.charm in ['heart', 'star', 'alien', 'mushroom', 'smiley', 'moon', 'bolt', 'butterfly', 'crown', 'flower', 'peace', 'planet', 'portal', 'compass'])
        && shortOrAbsent(request.resource.data, 'note', 140)
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
        && exists(path('profiles', me()));
      // Picking up kandi given by code: the first person (with a profile, not its maker, not blocked by them)
      // writes themselves in, once; nothing else changes.
      allow update: if signedIn()
        && !('to' in resource.data)
        && resource.data.from != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to', 'claimedAt'])
        && request.resource.data.to == me()
        && request.resource.data.claimedAt is string && request.resource.data.claimedAt.size() <= 40
        && exists(path('profiles', me()))
        && !hasBlocked(resource.data.from, me());
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.get('to', '') == me());
    }
    // Gift themes you were given (`<uid>_<theme>`): made by you from a sprout you picked up that came with
    // that theme. Read and removed only by you; the profile rules check it before showing the background.
    match /themeGrants/{id} {
      allow get: if signedIn() && (resource == null || resource.data.uid == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'theme', 'sprout', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.theme in giftThemes()
        && id == me() + '_' + request.resource.data.theme
        && request.resource.data.sprout is string && request.resource.data.sprout.matches('^[a-z0-9]{12,40}$')
        && get(path('sprouts', request.resource.data.sprout)).data.get('to', '') == me()
        && get(path('sprouts', request.resource.data.sprout)).data.get('theme', '') == request.resource.data.theme
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == me();
    }
    // Stickers you find in the wild: made in HQ, readable by anyone with the
    // code (the website shows one before you sign in), listed only in HQ.
    function stickerShape(d) {
      return d.keys().hasOnly(['name', 'creature', 'huntId', 'slot', 'until', 'festivalId', 'by', 'createdAt', 'orgId', 'gift', 'note'])
        && (!('gift' in d) || d.gift == true)
        && shortOrAbsent(d, 'note', 200)
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.creature is string && d.creature.matches('^[a-z]{2,20}$')
        && (('huntId' in d) == ('slot' in d))
        && (!('huntId' in d) || (d.huntId is string && d.huntId.matches('^[a-z0-9]{6,24}$') && d.slot is int && d.slot >= 0 && d.slot < 24))
        && (!('until' in d) || d.until is timestamp)
        && shortOrAbsent(d, 'festivalId', 120)
        && d.by == me() && d.createdAt == request.time;
    }
    match /stickers/{code} {
      allow get: if true;
      allow list: if isAdmin() || isOrgMember(resource.data.orgId);
      allow delete: if isAdmin();
      allow create: if code.matches('^[a-z0-9]{6,24}$') && stickerShape(request.resource.data)
        && (isAdmin()
          // An organizer's own sticker or gift, in one of its own hunts.
          || ('orgId' in request.resource.data && isOrgMember(request.resource.data.orgId)
            && (!('huntId' in request.resource.data) || get(path('hunts', request.resource.data.huntId)).data.get('orgId', '') == request.resource.data.orgId)));
      // Taking one down marks it (once): its code stops working, but scans from before still count.
      allow update: if (isAdmin() || isOrgMember(resource.data.get('orgId', ''))) && !('takenDown' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['takenDown', 'takenDownAt'])
        && request.resource.data.takenDown == true && request.resource.data.takenDownAt == request.time;
    }
    // A find of sticker `s` scanned at `at`: before its end date and before it was taken down (each sent up to 3 days after).
    function findOpen(s, at) {
      return (!('until' in s) || (at <= s.until && request.time < s.until + duration.value(3, 'd')))
        && (!('takenDown' in s) || (at <= s.takenDownAt && request.time < s.takenDownAt + duration.value(3, 'd')));
    }
    // A hunt: its stickers' creatures and names in order (no codes).
    match /hunts/{id} {
      allow get: if true;
      allow list: if isAdmin() || isOrgMember(resource.data.orgId);
      allow delete: if isAdmin() || isOrgMember(resource.data.get('orgId', ''));
      allow create: if id.matches('^[a-z0-9]{6,24}$')
        && (isAdmin() || ('orgId' in request.resource.data && isOrgMember(request.resource.data.orgId)))
        && request.resource.data.keys().hasOnly(['name', 'items', 'until', 'festivalId', 'by', 'createdAt', 'orgId'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.items == []
        && (!('until' in request.resource.data) || request.resource.data.until is timestamp)
        && shortOrAbsent(request.resource.data, 'festivalId', 120)
        && request.resource.data.by == me() && request.resource.data.createdAt == request.time;
      // Stickers join the end of it; one taken down stays in its place, marked gone.
      allow update: if (isAdmin() || isOrgMember(resource.data.get('orgId', '')))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 24
        && (request.resource.data.items.size() == resource.data.items.size() + 1
          || request.resource.data.items.size() == resource.data.items.size());
    }
    // Finds: you found a sticker (once each), before its end date or its takedown (sent up to 3 days later).
    match /finds/{id} {
      allow get, list: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'code', 'at', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.code is string && request.resource.data.code.matches('^[a-z0-9]{6,24}$')
        && id == me() + '_' + request.resource.data.code
        && request.resource.data.at is timestamp
        && request.resource.data.createdAt == request.time
        && exists(path('stickers', request.resource.data.code))
        && findOpen(get(path('stickers', request.resource.data.code)).data, request.resource.data.at);
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }
    // Event organizers' pages: anyone reads them (the website shows them signed out); HQ starts one; its
    // team (an email HQ added, confirmed) edits it, but never its promotions, which only HQ gives.
    function orgShape(d) {
      return d.keys().hasOnly(['name', 'tagline', 'about', 'website', 'instagram', 'mark', 'logoUrl', 'color', 'events', 'artists', 'claims', 'promoted', 'uids', 'handle', 'iconUrl', 'updatedAt'])
        // The @handle its accounts' profiles use.
        && (!('handle' in d) || (d.handle is string && d.handle.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$')))
        && (!('uids' in d) || (d.uids is list && d.uids.size() <= 10))
        // Imported events (EDMTrain's) it says are its own, by id.
        && (!('claims' in d) || (d.claims is list && d.claims.size() <= 60))
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && shortOrAbsent(d, 'tagline', 80) && shortOrAbsent(d, 'about', 600) && shortOrAbsent(d, 'website', 2000)
        && shortOrAbsent(d, 'instagram', 30) && shortOrAbsent(d, 'mark', 20) && shortOrAbsent(d, 'logoUrl', 2000) && shortOrAbsent(d, 'iconUrl', 2000) && shortOrAbsent(d, 'color', 7)
        && d.events is list && d.events.size() <= 40
        && d.artists is map && d.artists.size() <= 120
        && d.promoted is map && d.promoted.size() <= 40
        && d.updatedAt == request.time;
    }
    match /orgs/{id} {
      allow read: if true;
      allow create: if isAdmin() && id.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$') && orgShape(request.resource.data);
      // Its team never changes promotions, and changes who runs it only by adding or taking away their own account.
      allow update: if orgShape(request.resource.data)
        && (isAdmin() || (isOrgMember(id) && request.resource.data.promoted == resource.data.promoted
          && request.resource.data.get('handle', '') == resource.data.get('handle', '')
          && (request.resource.data.get('uids', []).toSet() == resource.data.get('uids', []).toSet()
            || request.resource.data.get('uids', []).toSet() == resource.data.get('uids', []).toSet().union([me()].toSet())
            || request.resource.data.get('uids', []).toSet() == resource.data.get('uids', []).toSet().difference([me()].toSet()))));
      allow delete: if isAdmin();
    }
    // Who may run an organizer's page: by email (lower case). You can read your own; HQ writes them.
    match /orgMembers/{email} {
      allow get: if isAdmin() || (signedIn() && orgEmail() == email);
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && email.matches('^[^@\\s/]+@[^@\\s/]+[.][^@\\s/]+$') && email == email.lower()
        && request.resource.data.keys().hasOnly(['orgId', 'by', 'at'])
        && request.resource.data.orgId is string && exists(path('orgs', request.resource.data.orgId))
        && request.resource.data.by == me() && request.resource.data.at == request.time;
    }
    // What an organizer asks HQ for (a promotion, a design, gifts): its team sends and reads them, HQ answers.
    match /orgRequests/{id} {
      allow read: if isAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId)
        && request.resource.data.keys().hasOnly(['orgId', 'by', 'kind', 'eventId', 'days', 'about', 'text', 'status', 'createdAt'])
        && request.resource.data.by == me()
        && request.resource.data.kind in ['promotion', 'design', 'gift', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && shortOrAbsent(request.resource.data, 'eventId', 40) && shortOrAbsent(request.resource.data, 'about', 40)
        && (!('days' in request.resource.data) || (request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 30))
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'answeredAt'])
        && request.resource.data.status in ['open', 'approved', 'declined', 'done']
        && shortOrAbsent(request.resource.data, 'reply', 1000) && request.resource.data.answeredAt == request.time;
      allow delete: if isAdmin();
    }
    // An organizer's numbers: one count per organizer, day (UTC, today only) and kind (a view, a ticket tap,
    // a promoted view, or `f_<code>`: a first find of one of its stickers), each adding one.
    // Only counts: never who. Its team and HQ read them.
    function isToday(day) {
      return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(day.split('-')[0]) == request.time.year() && int(day.split('-')[1]) == request.time.month() && int(day.split('-')[2]) == request.time.day();
    }
    // An event organizer's updates to its followers (features/organizers): its team posts and removes
    // them; anyone signed in reads them (followers see them in their notifications). An update can name
    // one of its events and one of its gift stickers.
    match /orgPosts/{id} {
      allow read: if signedIn();
      allow create: if isOrgMember(request.resource.data.orgId)
        && request.resource.data.keys().hasOnly(['orgId', 'uid', 'text', 'festivalId', 'gift', 'giftName', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && (!('festivalId' in request.resource.data) || (request.resource.data.festivalId is string && request.resource.data.festivalId.size() <= 120))
        && (!('gift' in request.resource.data) || (request.resource.data.gift is string && request.resource.data.gift.matches('^[a-z0-9]{6,24}$')))
        && (!('giftName' in request.resource.data) || (request.resource.data.giftName is string && request.resource.data.giftName.size() <= 60))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || isOrgMember(resource.data.orgId);
    }
    match /orgViews/{id} {
      allow read: if isAdmin() || isOrgMember(resource.data.orgId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orgId', 'day', 'key', 'n'])
        && request.resource.data.key is string && request.resource.data.key.matches('^(page|promo|tickets|e_[a-z0-9-]{1,40}|f_[a-z0-9]{6,24})$')
        && request.resource.data.orgId is string && exists(path('orgs', request.resource.data.orgId))
        && isToday(request.resource.data.day)
        && id == request.resource.data.orgId + '_' + request.resource.data.day + '_' + request.resource.data.key
        && request.resource.data.n == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
    // "Get tickets" taps on a festival (features/partners/ticketTaps.ts): one number per festival and day,
    // added to one at a time by anyone signed in, nothing about who. Only HQ reads them.
    match /ticketTaps/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['festivalId', 'day', 'n'])
        && request.resource.data.festivalId is string && request.resource.data.festivalId.matches('^[A-Za-z0-9_.-]{1,120}$')
        && isToday(request.resource.data.day)
        && id == request.resource.data.festivalId + '_' + request.resource.data.day
        && request.resource.data.n == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // 1-to-1 chats: `dms/<a>_<b>` (the two uids in order) between two people who follow each other, or
    // with an event organizer's account (see orgChat), started by either of them unless one blocked the other. Only the two of them read it. Messages and
    // read receipts are like a crew chat's; writing needs you to still be friends both ways and not blocked.
    // The support account can read any message (the rules can't tell a reported one apart); it reads one
    // only when handling a report or a safety issue (said in the privacy policy), and can remove it.
    match /dms/{id} {
      // Only the two named in the id may even ask whether it exists.
      allow get: if signedIn() && me() in id.split('_');
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'org'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.createdAt == request.time
        && (friendsBothWays(request.resource.data.members[0], request.resource.data.members[1]) || orgChat(request.resource.data))
        && !hasBlocked(request.resource.data.members[0], request.resource.data.members[1])
        && !hasBlocked(request.resource.data.members[1], request.resource.data.members[0]);
      allow update, delete: if false;

      match /reads/{uid} {
        allow read: if signedIn() && me() in get(path('dms', id)).data.members;
        allow create, update: if signedIn() && me() == uid && me() in get(path('dms', id)).data.members
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && me() == uid;
      }

      // Each person's push address, for the other one to notify them: read by the two of them, written by its owner.
      match /push/{uid} {
        allow read: if signedIn() && me() in get(path('dms', id)).data.members;
        allow create, update: if signedIn() && me() == uid && me() in get(path('dms', id)).data.members && pushShape(request.resource.data);
        allow delete: if signedIn() && me() == uid;
      }

      match /chat/{messageId} {
        allow read: if (signedIn() && me() in get(path('dms', id)).data.members) || isAdmin();
        allow create: if signedIn() && me() in get(path('dms', id)).data.members
          && (friendsBothWays(get(path('dms', id)).data.members[0], get(path('dms', id)).data.members[1]) || orgChat(get(path('dms', id)).data))
          && !hasBlocked(get(path('dms', id)).data.members[0] == me() ? get(path('dms', id)).data.members[1] : get(path('dms', id)).data.members[0], me())
          && messageId.matches('^[A-Za-z0-9_-]{6,64}$')
          && request.resource.data.keys().hasOnly(['uid', 'text', 'atMs', 'sentAt'])
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.atMs is number
          && request.resource.data.atMs <= request.time.toMillis() + 300000
          && request.resource.data.atMs >= request.time.toMillis() - 7 * 24 * 3600 * 1000
          && request.resource.data.sentAt == request.time;
        allow update: if false;
        allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
      }
    }

    match /crews/{id} {
      allow get: if signedIn();
      allow list: if (signedIn() && me() in resource.data.members) || isAdmin();
      allow create: if signedIn() && crewShape(request.resource.data)
        && request.resource.data.owner == me() && request.resource.data.members == [me()]
        && exists(path('profiles', me()));
      allow update: if signedIn() && crewShape(request.resource.data)
        && request.resource.data.festivalId == resource.data.festivalId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Join: add only yourself, at the end.
          (!(me() in resource.data.members)
            && request.resource.data.members == resource.data.members.concat([me()])
            && request.resource.data.owner == resource.data.owner && request.resource.data.name == resource.data.name
            && exists(path('profiles', me())) && !blockedBy(resource.data.owner) && joinedFairly(id))
          // Leave: remove only yourself; an owner hands the crew to someone still in it.
          || (me() in resource.data.members
            && request.resource.data.members == resource.data.members.removeAll([me()])
            && request.resource.data.name == resource.data.name
            && (request.resource.data.owner == resource.data.owner || resource.data.owner == me()))
          // The owner: rename, or remove other people (never add anyone).
          || (resource.data.owner == me() && request.resource.data.owner == me()
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0)
        );
      allow delete: if signedIn() && resource.data.owner == me();

      // Each member's starred sets, shared with the crew: written by that member, read by members,
      // removed by that member or the owner.
      match /picks/{uid} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create, update: if signedIn() && me() == uid && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['artists', 'updatedAt'])
          && request.resource.data.artists is list && request.resource.data.artists.size() <= 100
          && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
        allow delete: if signedIn() && (me() == uid || get(path('crews', id)).data.owner == me());
      }

      // The crew's meeting spot ("by the big tree left of Main Stage"): read and set by any member, as
      // themselves, stamped with the server's time. One document, `meet`. And `invite`: the code in the
      // crew's invite link, made by any member the first time it's asked for and changed only by the
      // owner (a new link). Only members can read either.
      match /meta/{doc} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create, update: if signedIn() && doc == 'meet' && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['text', 'by', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80
          && request.resource.data.by == me()
          && request.resource.data.at == request.time;
        // The crew's group photo: any member sets or replaces it, as themselves, pointing at their own file.
        allow create, update: if signedIn() && doc == 'cover' && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['url', 'by', 'at'])
          && request.resource.data.by == me() && request.resource.data.at == request.time
          && request.resource.data.url is string
          && request.resource.data.url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/[a-z0-9._-]+/o/crews%2F' + id + '%2F' + me() + '%2Fcover[.]jpg[?]alt=media&token=[A-Za-z0-9-]+$');
        allow create: if signedIn() && doc == 'invite' && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['code', 'by', 'at'])
          && request.resource.data.code is string && request.resource.data.code.matches('^[A-Za-z0-9]{12,40}$')
          && request.resource.data.by == me() && request.resource.data.at == request.time;
        allow update: if signedIn() && doc == 'invite' && get(path('crews', id)).data.owner == me()
          && request.resource.data.keys().hasOnly(['code', 'by', 'at'])
          && request.resource.data.code is string && request.resource.data.code.matches('^[A-Za-z0-9]{12,40}$')
          && request.resource.data.by == me() && request.resource.data.at == request.time;
        allow delete: if signedIn() && (((doc == 'meet' || doc == 'cover') && me() in get(path('crews', id)).data.members)
          || get(path('crews', id)).data.owner == me());
      }

      // How each member got in: that they agreed to the chat rules, and the link code they used (when
      // they weren't invited in the app). Written only by that person; read by them and the owner.
      match /joins/{uid} {
        allow read: if signedIn() && (me() == uid || get(path('crews', id)).data.owner == me());
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['agreed', 'code', 'at'])
          && request.resource.data.agreed == true
          && request.resource.data.at == request.time
          && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 40));
        allow delete: if signedIn() && (me() == uid || get(path('crews', id)).data.owner == me());
      }

      // When each member last read the chat (for "Seen by"): members read them; you write only your own,
      // with the server's time. Removed by that member or the owner.
      match /reads/{uid} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create, update: if signedIn() && me() == uid && me() in get(path('crews', id)).data.members
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && (me() == uid || get(path('crews', id)).data.owner == me());
      }

      // Each member's push address, for the crew to notify them: members read them, each writes their own
      // while in the crew; removed by that member or the owner (removing someone, ending the crew).
      match /push/{uid} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create, update: if signedIn() && me() == uid && me() in get(path('crews', id)).data.members && pushShape(request.resource.data);
        allow delete: if signedIn() && (me() == uid || get(path('crews', id)).data.owner == me());
      }

      // The crew's chat: members read it and write as themselves. `atMs` is when it was written on the
      // phone (no later than now, no older than a week); `sentAt` is the server's time. Never edited;
      // removed by the writer or the owner. The support account can read any message (the rules can't tell
      // a reported one apart); it reads one only when handling a report or a safety issue (said in the
      // privacy policy), and can remove it.
      match /chat/{messageId} {
        allow read: if (signedIn() && me() in get(path('crews', id)).data.members) || isAdmin();
        allow create: if signedIn() && me() in get(path('crews', id)).data.members
          && messageId.matches('^[A-Za-z0-9_-]{6,64}$')
          && request.resource.data.keys().hasOnly(['uid', 'text', 'atMs', 'sentAt'])
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.atMs is number
          && request.resource.data.atMs <= request.time.toMillis() + 300000
          && request.resource.data.atMs >= request.time.toMillis() - 7 * 24 * 3600 * 1000
          && request.resource.data.sentAt == request.time;
        allow update: if false;
        allow delete: if (signedIn() && (resource.data.uid == me() || get(path('crews', id)).data.owner == me())) || isAdmin();
      }

      // Crew updates: where a member is and what they're seeing, from a video or a check-in. Members read
      // them; you post only as yourself while you're in the crew. `atMs` is when it happened on the phone
      // (no later than now, no older than a week); `sentAt` must be the server's own time, so "reached
      // the crew at" can't be faked. A reply answers another update in the crew. Never edited; removed by
      // the author or the owner.
      match /updates/{updateId} {
        allow read: if signedIn() && me() in get(path('crews', id)).data.members;
        allow create: if signedIn() && me() in get(path('crews', id)).data.members
          && updateId.matches('^[A-Za-z0-9_-]{6,64}$')
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'atMs', 'sentAt', 'festivalId', 'artistId', 'stage', 'note', 'videoUrl', 'thumbUrl', 'videoPath', 'thumbPath', 'sharedId', 'durationSec', 'width', 'height', 'replyTo', 'lost', 'care'])
          && request.resource.data.uid == me()
          && request.resource.data.kind in ['video', 'checkin', 'reply', 'photo']
          && request.resource.data.atMs is number
          && request.resource.data.atMs <= request.time.toMillis() + 300000
          && request.resource.data.atMs >= request.time.toMillis() - 7 * 24 * 3600 * 1000
          && request.resource.data.sentAt == request.time
          && request.resource.data.festivalId is string && request.resource.data.festivalId.size() <= 100
          && request.resource.data.festivalId == get(path('crews', id)).data.festivalId
          && shortOrAbsent(request.resource.data, 'artistId', 100)
          && shortOrAbsent(request.resource.data, 'stage', 60)
          && shortOrAbsent(request.resource.data, 'note', 80)
          && shortOrAbsent(request.resource.data, 'sharedId', 128)
          && shortOrAbsent(request.resource.data, 'videoPath', 300)
          && shortOrAbsent(request.resource.data, 'thumbPath', 300)
          && (!('videoUrl' in request.resource.data) || (request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() <= 2000 && request.resource.data.videoUrl.matches('^https://.*')))
          && (!('thumbUrl' in request.resource.data) || (request.resource.data.thumbUrl is string && request.resource.data.thumbUrl.size() <= 2000 && request.resource.data.thumbUrl.matches('^https://.*')))
          && (request.resource.data.kind != 'video' || 'videoUrl' in request.resource.data)
          // A photo (crews only): the picture, and no video.
          && (request.resource.data.kind != 'photo' || ('thumbUrl' in request.resource.data && !('videoUrl' in request.resource.data)))
          // A reply has words and answers an update that's in this crew.
          && (request.resource.data.kind != 'reply' || (request.resource.data.replyTo is string
            && request.resource.data.replyTo.matches('^[A-Za-z0-9_-]{6,64}$')
            && exists(/databases/$(database)/documents/crews/$(id)/updates/$(request.resource.data.replyTo))
            && request.resource.data.note is string && request.resource.data.note.size() > 0
            && !('videoUrl' in request.resource.data)))
          && (request.resource.data.kind == 'reply' || !('replyTo' in request.resource.data))
          // "Can't find you": only on a check-in.
          && (!('lost' in request.resource.data) || (request.resource.data.lost == true && request.resource.data.kind == 'checkin'))
          // "I'm OK" or "come find me": only on a check-in.
          && (!('care' in request.resource.data) || (request.resource.data.care in ['ok', 'help'] && request.resource.data.kind == 'checkin'))
          && (!('durationSec' in request.resource.data) || (request.resource.data.durationSec is number && request.resource.data.durationSec <= 600))
          && (!('width' in request.resource.data) || (request.resource.data.width is number && request.resource.data.width <= 20000))
          && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height <= 20000));
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == me() || get(path('crews', id)).data.owner == me());
      }
    }

    // Your push address on its own: for crew invites from friends (both ways) and support replies (the support
    // account). Only you write it.
    match /pushTokens/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin() || friendsBothWays(me(), uid));
      allow create, update: if signedIn() && me() == uid && pushShape(request.resource.data);
      allow delete: if signedIn() && me() == uid;
    }

    // Reports: anyone signed in can file one (open, at the server's time, so it can't be dated to sink
    // below others); only the support account reads them (open ones first) and deals with them.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['by', 'kind', 'targetId', 'ownerUid', 'reason', 'note', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['profile', 'memory', 'comment', 'clipComment', 'chat']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128
        && request.resource.data.ownerUid is string && request.resource.data.ownerUid.size() <= 128
        && request.resource.data.reason in ['offensive', 'harassment', 'spam', 'not-theirs', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
      // Read and dealt with on the support account's dashboard.
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['open', 'resolved'];
    }

    // When an account last opened the app (the dashboard's active and inactive counts): only the days and
    // times it opened, its platform and version, and whether it has a profile; never what anyone did.
    // You write your own; only you and the support account read it; it goes with the account.
    match /activity/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['firstSeenAt', 'lastSeenAt', 'days', 'platform', 'version', 'hasProfile'])
        && request.resource.data.firstSeenAt is string && request.resource.data.firstSeenAt.size() <= 40
        && request.resource.data.lastSeenAt is string && request.resource.data.lastSeenAt.size() <= 40
        && request.resource.data.days is list && request.resource.data.days.size() <= 90
        && request.resource.data.hasProfile is bool
        && shortOrAbsent(request.resource.data, 'platform', 20)
        && shortOrAbsent(request.resource.data, 'version', 80);
      allow delete: if signedIn() && me() == uid;
    }

    // Support messages: you write yours (as yourself, marked open, stamped with the server's time; any
    // email is your sign-in email and any handle your profile's) and read only your own, and they go with
    // your account; the support account reads them all, replies (every reply kept), and closes them.
    match /support/{id} {
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'name', 'email', 'topic', 'text', 'platform', 'version', 'status', 'createdAt'])
        && request.resource.data.topic in ['help', 'bug', 'idea', 'festival', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (!('handle' in request.resource.data) || (exists(path('profiles', me()))
          && request.resource.data.handle == get(path('profiles', me())).data.handle))
        && shortOrAbsent(request.resource.data, 'name', 60)
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && shortOrAbsent(request.resource.data, 'platform', 20)
        && shortOrAbsent(request.resource.data, 'version', 80);
      allow read: if signedIn() && (resource.data.uid == me() || isAdmin());
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt', 'replies'])
        && request.resource.data.status in ['open', 'answered', 'closed']
        && shortOrAbsent(request.resource.data, 'reply', 2000)
        && (!('replies' in request.resource.data) || (request.resource.data.replies is list && request.resource.data.replies.size() <= 20));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == me());
    }
  }
}
