# Copy to .env (git ignores it) and fill in. See docs/music-integrations.md.
# Neither value is a secret; no secret ever goes in the app.

# Spotify app Client ID (developer.spotify.com > Dashboard > your app).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# https link to your service that returns { "token": "<MusicKit developer token>" }.
EXPO_PUBLIC_APPLE_MUSIC_TOKEN_URL=
