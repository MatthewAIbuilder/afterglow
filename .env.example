# Copy this file to .env (git ignores .env) and fill it in. Nothing here is a
# secret, and no secret ever goes in the app. Full steps: docs/spotify-setup.md

# Spotify app Client ID (developer.spotify.com > Dashboard > your app > Settings).
# Public by design: Afterglow signs in with PKCE, so there is no client secret.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Only if Spotify's dashboard refuses afterglow://music-auth: an https link on a
# domain you control that opens the app (universal link). Leave empty otherwise.
# Must match the Redirect URI in the Spotify dashboard exactly.
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=

# Apple Music (not connected yet): https link to your service that returns
# { "token": "<MusicKit developer token>" }. Leave empty for now.
EXPO_PUBLIC_APPLE_MUSIC_TOKEN_URL=

# Profiles (Firebase): the six values from your Firebase web app's config.
# Public by design; firestore.rules and storage.rules protect the data.
# Leave empty and profiles say they aren't available. See docs/firebase-setup.md.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
